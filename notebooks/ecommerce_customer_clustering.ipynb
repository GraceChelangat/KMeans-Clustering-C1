      "source": [
        "# Import KneeLocator to identify the elbow point\n",
        "from kneed import KneeLocator\n",
        "\n",
        "# Find the elbow point from the inertia values\n",
        "knee = KneeLocator(\n",
        "    list(k_values),\n",
        "    inertias,\n",
        "    curve=\"convex\",\n",
        "    direction=\"decreasing\"\n",
        ")\n",
        "\n",
        "elbow_k = knee.elbow\n",
        "\n",
        "# Display the Elbow Method result\n",
        "print(\"Best k according to Elbow Method:\", elbow_k)\n",
        "\n",
        "# Display the Silhouette result\n",
        "print(\"Best k according to Silhouette Score:\", best_silhouette_k)\n",
        "\n",
        "# Display the Davies-Bouldin result\n",
        "print(\"Best k according to Davies-Bouldin Index:\", best_db_k)\n",
        "\n",
        "\n",
        "# Put all three methods into one comparison table\n",
        "method_comparison = pd.DataFrame({\n",
        "    \"Method\": [\n",
        "        \"Elbow Method\",\n",
        "        \"Silhouette Score\",\n",
        "        \"Davies-Bouldin Index\"\n",
        "    ],\n",
        "    \"Preferred k\": [\n",
        "        elbow_k,\n",
        "        best_silhouette_k,\n",
        "        best_db_k\n",
        "    ],\n",
        "    \"Decision Rule\": [\n",
        "        \"Point where inertia begins to level off\",\n",
        "        \"Highest score\",\n",
        "        \"Lowest index\"\n",
        "    ]\n",
        "})\n",
        "\n",
        "display(method_comparison)\n",
        "\n",
        "\n",
        "# Check whether all three methods agree\n",
        "preferred_k_values = [\n",
        "    elbow_k,\n",
        "    best_silhouette_k,\n",
