        "from sklearn.impute import SimpleImputer\n",
        "\n",
        "# Build the feature matrix from the features Member 2 selected for clustering\n",
        "X = df[clustering_features].copy()\n",
        "\n",
        "print(\"Missing values per clustering feature, before imputation:\")\n",
        "print(X.isnull().sum())\n",
        "\n",
        "# Median imputation: fit on the training data only, and keep the fitted imputer\n",
        "# so the exact same learned median can be applied to new customers later.\n",
        "imputer = SimpleImputer(strategy=\"median\")\n",
        "X_imputed = pd.DataFrame(\n",
        "    imputer.fit_transform(X),\n",
        "    columns=clustering_features,\n",
        "    index=X.index\n",
        ")\n",
        "\n",
        "print(\"\\nMissing values per clustering feature, after imputation:\")\n",
        "print(X_imputed.isnull().sum())\n",
        "print(f\"\\nMedian used to fill avg_order_value_kes: {imputer.statistics_[clustering_features.index('avg_order_value_kes')]:.2f} KES\")"
      ]
    },
