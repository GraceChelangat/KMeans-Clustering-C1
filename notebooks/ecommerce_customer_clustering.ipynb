      "source": [
        "from kneed import KneeLocator\n",
        "\n",
        "# Find the elbow point from the inertia results\n",
        "knee = KneeLocator(\n",
        "    list(k_values),\n",
        "    inertias,\n",
        "    curve=\"convex\",\n",
        "    direction=\"decreasing\"\n",
        ")\n",
        "\n",
        "elbow_k = knee.elbow\n",
        "\n",
        "print(\"Elbow Method suggests k =\", elbow_k)"
      ]
