      "source": [
        "from sklearn.preprocessing import RobustScaler\n",
        "\n",
        "# Apply an alternative scaling method to the SAME imputed features\n",
        "robust_scaler = RobustScaler()\n",
        "\n",
        "X_robust = robust_scaler.fit_transform(X_imputed)\n",
        "\n",
        "robust_scaling_results = []\n",
        "\n",
        "for k in k_values:\n",
        "    \n",
        "    model = KMeans(\n",
        "        n_clusters=k,\n",
        "        random_state=42,\n",
        "        n_init=20\n",
        "    )\n",
        "    \n",
        "    labels = model.fit_predict(X_robust)\n",
        "    \n",
        "    robust_scaling_results.append({\n",
        "        \"k\": k,\n",
        "        \"Silhouette Score\": silhouette_score(X_robust, labels),\n",
        "        \"Davies-Bouldin Index\": davies_bouldin_score(X_robust, labels)\n",
        "    })\n",
        "\n",
        "robust_scaling_df = pd.DataFrame(robust_scaling_results)\n",
        "\n",
        "robust_scaling_df.round(4)"
      ]
    },
